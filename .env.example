# ---------------------------------------------------------------------------
# EXLSmartAssist environment configuration
# Copy this file to .env and adjust as needed. All AI/LLM variables are
# OPTIONAL — with none set, the backend automatically uses the built-in
# grounded Mock LLM Simulator so the entire app works out-of-the-box.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------
POSTGRES_USER=exlsmartassist
POSTGRES_PASSWORD=exlsmartassist
POSTGRES_DB=exlsmartassist
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://exlsmartassist:exlsmartassist@postgres:5432/exlsmartassist

# --- Vector store ---------------------------------------------------------
VECTOR_DB_PATH=app/data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM provider (OPTIONAL) ----------------------------------------------
# Leave all blank to use the Mock LLM Simulator (default, no cost, no key).
# Option A: OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option B: Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# --- Backend ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_PORT=8000

# --- Frontend ----------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
